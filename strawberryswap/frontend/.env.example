# Inlined at BUILD time (static export). Never put secrets here: everything below ships to the browser.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_CHAIN_NAME=Local
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_DARKPOOL_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
# Automator (intent relayer) base URL; leave empty to disable intent submission
NEXT_PUBLIC_AUTOMATOR_URL=
# Block the DarkPool was deployed in (where the wallet starts scanning for notes), and getLogs range size
NEXT_PUBLIC_DEPLOY_BLOCK=0
NEXT_PUBLIC_LOG_CHUNK=2000
# Testnet builds (scripts/env-from-manifest.mjs writes all of the above from contracts/deployments/<chainId>.json).
# Chains 421614 (Arbitrum Sepolia) and 31337 (anvil) always show the trusted-bootstrap banner; 1 marks any other chain.
NEXT_PUBLIC_TESTNET=
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_DISCLOSURE_ADDRESS=
NEXT_PUBLIC_TWETH_ADDRESS=
NEXT_PUBLIC_TUSD_ADDRESS=
