# Inlined at BUILD time (static export). Never put secrets here: everything below ships to the browser.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_CHAIN_NAME=Local
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_DARKPOOL_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
# Automator (intent relayer) base URL; leave empty to disable intent submission
NEXT_PUBLIC_AUTOMATOR_URL=
