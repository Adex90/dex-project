{
  "name": "strawberryswap-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Static, IPFS-deployable trading UI for StrawberrySwap",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "verify:static": "node scripts/verify-static.mjs",
    "prepare:zk": "node scripts/prepare-zk.mjs",
    "prebuild": "node scripts/prepare-zk.mjs",
    "test:zk": "tsx --test zk-tests/golden.test.ts zk-tests/engine.test.ts zk-tests/automator.test.ts",
    "test:zk:proofs": "tsx --test zk-tests/proving.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "next": "^15.1.0",
    "poseidon-lite": "^0.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "snarkjs": "^0.7.5",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
