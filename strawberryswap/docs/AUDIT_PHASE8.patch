diff -ruN a/contracts/audit/P3Check.t.sol b/contracts/audit/P3Check.t.sol
--- a/contracts/audit/P3Check.t.sol
+++ b/contracts/audit/P3Check.t.sol
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+import {AuditBase} from "./DarkPoolExploits.t.sol";
+import {DarkPool} from "../src/dex/DarkPool.sol";
+import {Math} from "../src/utils/Math.sol";
+import {IERC20Min} from "../src/interfaces/IERC20Min.sol";
+import {MockSearcher} from "../test/mocks/Mocks.sol";
+
+/// Scratch-only: P-3 on its own removes C-2's primitive (a proportional deposit no longer moves the price).
+contract P3Check is AuditBase {
+    function setUp() public { _tokens(); vm.warp(1_000_000); }
+
+    function test_P3_proportionalLiquidityNoLongerMovesThePrice() public {
+        DarkPool p = _pool(t0, t1, 1_000e18, 2_000_000e18);
+        _addLiq(p, lp, 100e18, 200_000e18);
+        uint256 P = 2_400e18;
+        oracle.set(P);
+        // the market moves; a searcher rebalances to 2400 through the DESIGNED path (flashRebalance)
+        (uint256 x, uint256 y) = p.effectiveReserves();
+        uint256 xt = Math.sqrt(x * y * WAD / P);
+        uint256 out0 = x - xt;
+        uint256 in1 = x * y / (x - out0) + 1 - y;
+        uint256 req = p.quoteMinPayment(uint256(p.reserve0()) - out0, uint256(p.reserve1()) + in1);
+        MockSearcher s = new MockSearcher(IERC20Min(address(t0)), IERC20Min(address(t1)), address(p), address(treasury));
+        t1.mint(address(s), in1 + req);
+        s.configure(0, in1, 0);
+        s.go(abi.encodeCall(DarkPool.flashRebalance, (out0, 0, address(s), "")));
+        uint256 spot0 = p.spotPrice();
+        assertApproxEqRel(spot0, P, 1e12);
+
+        uint256 sh = _addLiq(p, attacker, uint256(p.reserve0()) * 100, uint256(p.reserve1()) * 100);
+        uint256 spot1 = p.spotPrice();
+        vm.prank(attacker);
+        p.removeLiquidity(sh, attacker);
+        uint256 spot2 = p.spotPrice();
+        emit log_named_decimal_uint("spot before add ", spot0, 18);
+        emit log_named_decimal_uint("spot after add  ", spot1, 18);
+        emit log_named_decimal_uint("spot after remove", spot2, 18);
+        assertApproxEqRel(spot1, spot0, 1e6, "price moved by a proportional deposit"); // 1e-12 relative
+        assertApproxEqRel(spot2, spot0, 1e6, "price moved by a proportional withdrawal");
+    }
+}
