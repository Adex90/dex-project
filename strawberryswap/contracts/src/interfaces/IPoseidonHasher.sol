pragma solidity ^0.8.24;

/// @title IPoseidonHasher
/// @notice 2-to-1 Poseidon (BN254, t=3) used for the note Merkle tree. Deploy the bytecode generated by
///         circomlibjs `poseidonContract` behind this ABI. Must be byte-identical to the circuit's hash.
interface IPoseidonHasher {
    function poseidon(bytes32 left, bytes32 right) external view returns (bytes32);
}
