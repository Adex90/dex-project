pragma solidity ^0.8.24;

import {IZKVerifier} from "../interfaces/IZKVerifier.sol";
import {IPoseidonHasher} from "../interfaces/IPoseidonHasher.sol";

/// @dev ABI of a snarkjs-generated Groth16 verifier for a circuit with 9 public inputs (JoinSplit).
interface IGroth16Verifier9 {
    function verifyProof(uint256[2] calldata a, uint256[2][2] calldata b, uint256[2] calldata c, uint256[9] calldata pub)
        external
        view
        returns (bool);
}

/// @title JoinSplitVerifierAdapter
/// @notice Connects a snarkjs Groth16 verifier for `circuits/joinsplit` to the generic `IZKVerifier` used by
///         NoteTree (Berrycoin, OptionsMarket, DarkPool).
///
/// Proof wire format: `abi.encode(uint256[2] a, uint256[2][2] b, uint256[2] c)` = exactly 256 bytes.
/// Public inputs MUST be, in order: [root, nullifier0, nullifier1, commitment0, commitment1, publicIn,
/// publicOut, extDataHash, assetId] — the order NoteTree._applyJoinSplit builds and the circuit declares.
///
/// Fail-closed: wrong proof length or wrong number of inputs returns false (never reverts into a state
/// where a caller could mistake an exception for success), and the underlying verifier itself returns
/// false for any proof that does not verify or whose inputs are not reduced field elements.
///
/// GAS CAP: a malformed proof (off-curve point, bad field element) makes a snarkjs verifier fail inside an
/// EC precompile, and a failed precompile call consumes ALL the gas forwarded to it. Without a cap, any caller
/// could make a transaction burn ~63/64 of its entire gas limit (the tests measured ~1e9 gas). Forwarding a
/// fixed budget bounds the worst case. Valid proofs cost roughly 250-300k gas on Ethereum-equivalent chains;
/// set the cap with headroom for the target chain's pairing-precompile pricing (zk-rollups differ).
contract JoinSplitVerifierAdapter is IZKVerifier {
    IGroth16Verifier9 public immutable verifier;
    uint256 public immutable gasCap;

    error GasCapTooLow();

    constructor(IGroth16Verifier9 verifier_, uint256 gasCap_) {
        if (gasCap_ < 300_000) revert GasCapTooLow();
        verifier = verifier_;
        gasCap = gasCap_;
    }

    function verifyProof(bytes calldata proof, uint256[] calldata pub) external view returns (bool) {
        if (proof.length != 256 || pub.length != 9) return false;
        (uint256[2] memory a, uint256[2][2] memory b, uint256[2] memory c) =
            abi.decode(proof, (uint256[2], uint256[2][2], uint256[2]));
        uint256[9] memory p;
        for (uint256 i; i < 9; ++i) p[i] = pub[i];
        // memory -> external call re-encodes; `verifyProof` takes calldata-compatible ABI types
        try verifier.verifyProof{gas: gasCap}(a, b, c, p) returns (bool ok) {
            return ok;
        } catch {
            return false;
        }
    }
}

/// @title PoseidonHasherAdapter
/// @notice Wraps the bytecode generated by circomlibjs `poseidonContract.createCode(2)` (ABI:
///         `poseidon(uint256[2]) returns (uint256)`) behind `IPoseidonHasher`. This is the hasher whose output
///         is bit-identical to circom's `Poseidon(2)`, so on-chain roots equal in-circuit roots.
interface IPoseidonT3 {
    function poseidon(uint256[2] calldata) external pure returns (uint256);
}

contract PoseidonHasherAdapter is IPoseidonHasher {
    IPoseidonT3 public immutable poseidonT3;

    constructor(IPoseidonT3 p) {
        poseidonT3 = p;
    }

    function poseidon(bytes32 left, bytes32 right) external view returns (bytes32) {
        return bytes32(poseidonT3.poseidon([uint256(left), uint256(right)]));
    }
}
