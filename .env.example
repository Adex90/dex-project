# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=synthetic
POSTGRES_PASSWORD=synthetic
POSTGRES_DB=synthetic_capital
# The application user needs CREATEROLE (or superuser) the first time
# migrations run: they create the roles sc_ifpe, sc_sofom, sc_puente,
# sc_auditor, sc_kyc, sc_kyc_verificador, sc_spei, sc_aml and sc_auditor_pld
# (an optional external verifier of the AML audit log; the app never uses it).
# Integration tests also need CREATEDB.
DATABASE_URL=postgres://synthetic:synthetic@localhost:5432/synthetic_capital
DB_MAX_CONEXIONES=20
# Production: migrate and bootstrap as the schema owner, and serve with a
# login (DATABASE_URL) that is only a member of the sc_* roles, so the running
# service cannot disable triggers. See README "Production database users".
DATABASE_URL_PROPIETARIO=

# --- Backend (Rust / Axum) ---------------------------------------------------
BIND_ADDR=0.0.0.0:8080
# Required, also in MODO_DEMO. Placeholder or low-entropy values are rejected
# at startup. Generate one with: openssl rand -hex 64
JWT_SECRET=
JWT_TTL_MINUTOS=60
FRONTEND_ORIGIN=http://localhost:3000
RUST_LOG=info,synthetic_capital=debug
# Apply migrations on startup (embedded in the binary).
MIGRAR_AL_INICIO=true

# HTTP limits (seconds, except the connection cap).
# Behind your own reverse proxy: take the client IP (KYC audit) from the last
# X-Forwarded-For hop. Never enable it without a proxy (clients can forge it).
HTTP_PROXY_CONFIABLE=false
HTTP_CABECERAS_SEG=10
HTTP_CUERPO_SEG=15
HTTP_PETICION_SEG=30
HTTP_MAX_CONEXIONES=512
HTTP_APAGADO_SEG=20

# DEMO ONLY: self-service simulated deposits (still require verified KYC).
MODO_DEMO=false

# CLABE prefix for new accounts: bank code (3) + plaza (3), plus up to 4
# more digits (e.g. STP's company prefix: 646180 + 1234). Placeholder value.
CLABE_PREFIJO=999180

# --- KYC / biometric onboarding ----------------------------------------------
# HMAC-SHA256 secret the biometric provider signs its results with (>= 32
# chars, random). Empty: a random per-process secret is generated, so only the
# bundled simulated provider can sign and the external webhook stays closed.
KYC_WEBHOOK_SECRETO=
KYC_WEBHOOK_SECRETO_ANTERIOR=
KYC_TOLERANCIA_FIRMA_SEG=300
# Written to kyc.parametros at startup (the database enforces them). Empty
# keeps the stored values (defaults 0.85 / 0.70 / 3).
KYC_SCORE_MINIMO=
KYC_SCORE_REVISION=
KYC_MAX_INTENTOS=

# --- SPEI ---------------------------------------------------------------------
# HMAC-SHA256 secret for provider webhooks (>= 32 chars, random). Without it
# the webhooks answer 503. During rotation, also set the previous one.
SPEI_WEBHOOK_SECRETO=
SPEI_WEBHOOK_SECRETO_ANTERIOR=
SPEI_TOLERANCIA_FIRMA_SEG=300
# Our tracking-key prefix (1-8 letters/digits).
SPEI_PREFIJO_RASTREO=SC
# Outgoing dispatcher (0 disables it), status polling and safety limits.
SPEI_DESPACHO_INTERVALO_MS=1000
SPEI_CONSULTA_INTERVALO_SEG=5
SPEI_ESPERA_INCIERTO_SEG=60
SPEI_MAX_INTENTOS=20
SPEI_LOTE=50
SPEI_VENTANA_DEVOLUCION_DIAS=3

# First operator, created on startup if it does not exist.
BOOTSTRAP_OPERADOR_EMAIL=
BOOTSTRAP_OPERADOR_PASSWORD=

# Background jobs (seconds; 0 disables them).
CORTE_INTERVALO_SEG=300
# A new client's proof request may trigger a snapshot only if the latest one
# is older than this (bounds the cost of on-demand snapshots).
CORTE_MIN_INTERVALO_SEG=60
LIQUIDACION_INTERVALO_SEG=3600

# AML/CFT (PLD/FT) monitoring. Thresholds and rules live in the database
# (aml.reglas_riesgo, aml.parametros) and change only with four-eyes approval.
# Batch monitoring cycle in seconds (0 disables it) and ledger rows per cycle.
AML_MONITOREO_INTERVALO_SEG=300
AML_MONITOREO_LOTE=5000
# MODO_DEMO only: compliance officers created on startup (comma-separated).
# Each is named after the local part of the email ("Cumplimiento oficial1"),
# so the console can tell the two officers of a four-eyes decision apart.
BOOTSTRAP_CUMPLIMIENTO_EMAILS=
BOOTSTRAP_CUMPLIMIENTO_PASSWORD=

# Custody accounts created on startup if none are active.
RESERVA_INSTITUCION=Banco de México
RESERVA_CUENTA=SC-IFPE-RESERVA-001
CAJA_INSTITUCION=Banco Custodio SOFOM
CAJA_CUENTA=SC-SOFOM-CAJA-001

# --- Frontend (Next.js) ------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
# Compliance contact shown in onboarding (locks, rejections, biometric consent).
NEXT_PUBLIC_COMPLIANCE_EMAIL=compliance@synthetic-capital.example
