# Settings for docker-compose.yml (single-host deployment). Copy to deploy/compose.env
# (ignored by git), fill it in and pass it explicitly to every command:
#
#   docker compose --env-file deploy/compose.env up -d --build
#
# NO SECRETS IN THIS FILE. Passwords, keys and connection URLs are Docker secrets that
# scripts/generate-secrets.sh writes to ./secrets. Docker compose reads this file only to
# substitute ${...} in docker-compose.yml; variables exported in the shell take precedence.
# Values run to the end of the line; quotes are optional.

# --- Edge ------------------------------------------------------------------------------
# Public host name: its DNS A/AAAA record points at this host and the TLS certificate in
# CERTS_DIR covers it. The frontend is built for https://<PUBLIC_HOST> (rebuild on change).
PUBLIC_HOST=
# Host address the published ports 80 and 443 bind to (0.0.0.0 = every interface).
EDGE_BIND=0.0.0.0
# fullchain.pem + privkey.pem readable by uid 101 (certbot deploy hook, DEPLOYMENT.md).
CERTS_DIR=./certs
# ACME http-01 webroot that certbot writes to.
ACME_DIR=./acme
# nginx access and error logs, read by fail2ban (scripts/hardening.sh).
NGINX_LOG_DIR=./logs/nginx
# Output directory of scripts/generate-secrets.sh.
SECRETS_DIR=./secrets

# --- Database ----------------------------------------------------------------------------
# Names only, fixed once the volume is initialised. scripts/generate-secrets.sh reads both
# to build the connection URLs, so set them before generating the secrets. DB_OWNER is the
# schema owner the migrate job connects as (not a superuser; the superuser is "postgres").
DB_OWNER=synthetic_owner
POSTGRES_DB=synthetic_capital

# --- Institution (written to the database by the migrate job) ----------------------------
# CLABE prefix for new accounts: bank code (3) + plaza (3), plus up to 4 more digits.
CLABE_PREFIJO=
# Custody account holding the IFPE's 100% reserve.
RESERVA_INSTITUCION=Banco de México
RESERVA_CUENTA=
# SOFOM's own cash account.
CAJA_INSTITUCION=
CAJA_CUENTA=
# First operator account (its password is ./secrets/bootstrap_operador_password). Empty:
# no operator is created.
BOOTSTRAP_OPERADOR_EMAIL=
# Written to kyc.parametros on every migrate run. Empty keeps the stored values
# (defaults 0.85 / 0.70 / 3).
KYC_SCORE_MINIMO=
KYC_SCORE_REVISION=
KYC_MAX_INTENTOS=

# --- Demo stacks only --------------------------------------------------------------------
# true enables the simulated SPEI and biometric providers and self-service deposits.
# NEVER true in production.
MODO_DEMO=false
# Demo compliance officers (MODO_DEMO=true only; in production the DBA creates officers).
# Set both: comma-separated emails, and the in-container path of the generated password
#   BOOTSTRAP_CUMPLIMIENTO_PASSWORD_FILE=/run/secrets/bootstrap_cumplimiento_password
BOOTSTRAP_CUMPLIMIENTO_EMAILS=
BOOTSTRAP_CUMPLIMIENTO_PASSWORD_FILE=

# --- Service tuning (defaults shown) -----------------------------------------------------
RUST_LOG=info
DB_MAX_CONEXIONES=20
JWT_TTL_MINUTOS=60
SPEI_PREFIJO_RASTREO=SC
SPEI_DESPACHO_INTERVALO_MS=1000
SPEI_HORA_CORTE=17:30
CORTE_INTERVALO_SEG=300
CORTE_MIN_INTERVALO_SEG=60
LIQUIDACION_INTERVALO_SEG=3600
AML_MONITOREO_INTERVALO_SEG=300

# --- Images ------------------------------------------------------------------------------
# Compliance contact shown in the web app (inlined at build time).
NEXT_PUBLIC_COMPLIANCE_EMAIL=
# Built locally by `docker compose build` unless these name pushed images (pin the
# digest: registry.example/synthetic-capital-backend@sha256:...).
BACKEND_IMAGE=synthetic-capital-backend:local
FRONTEND_IMAGE=synthetic-capital-frontend:local
# Recorded in the image labels (org.opencontainers.image.revision): git rev-parse HEAD.
REVISION=unknown
